{
  "name": "claude-meeting-assistant",
  "version": "0.1.0",
  "description": "A Teams meeting assistant that listens, answers by voice and chat, and writes recaps, using Azure Communication Services and the Claude API.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.page.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node src/worker/build-page.mjs",
    "build:page": "node src/worker/build-page.mjs",
    "test": "vitest run",
    "start:control": "node dist/control/main.js",
    "start:worker": "node dist/worker/main.js",
    "dev:control": "tsx watch --env-file-if-exists=.env src/control/main.ts",
    "demo": "npm run build:page && tsx --env-file-if-exists=.env scripts/local-demo.ts",
    "spike": "npm run build:page && tsx --env-file-if-exists=.env scripts/spike-join.ts",
    "kb:ingest": "tsx --env-file-if-exists=.env scripts/ingest-kb.ts",
    "purge": "tsx --env-file-if-exists=.env scripts/purge.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "teams:package": "node teams-app/build-package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@azure/arm-appcontainers": "4.0.0",
    "@azure/communication-calling": "2.0.0",
    "@azure/communication-common": "2.5.0",
    "@azure/communication-identity": "2.0.0",
    "@azure/data-tables": "13.3.2",
    "@azure/identity": "4.14.1",
    "@azure/msal-node": "7.2.2",
    "@azure/storage-blob": "12.34.0",
    "@microsoft/teams.api": "2.2.1",
    "@microsoft/teams.apps": "2.2.1",
    "@microsoft/teams.cards": "2.2.1",
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "playwright-core": "1.65.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "azurite": "3.37.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
