# Copy to .env for local runs. In Azure these are set by infra/apps.bicep.
# Lines marked REQUIRED must be set for the control service to start.

# ---- Identity of the assistant ----------------------------------------------------------
ASSISTANT_NAME=Claude
ORGANISATION_NAME=Imperial Learning Ltd
# Shown in the meeting roster. Keep the words that say it is an AI.
BOT_DISPLAY_NAME=Claude (AI assistant)
# Names people may say after "hey". Comma separated.
WAKE_NAMES=claude
# Spoken language of the meetings, as a Teams captions language code.
SPOKEN_LANGUAGE=en-gb

# ---- Microsoft 365 ------------------------------------------------------------------------
# Tenant id of your Microsoft 365 organisation.
TENANT_ID=
# Only people from these tenants may use the assistant. Defaults to TENANT_ID.
ALLOWED_TENANT_IDS=
# App registration of the bot (single tenant). Without these the Teams chat side is disabled.
CLIENT_ID=
CLIENT_SECRET=

# ---- Claude API -------------------------------------------------------------------------
# REQUIRED
ANTHROPIC_API_KEY=
LIVE_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-sonnet-5-5
RECAP_MODEL=claude-sonnet-5-5
# low gives the fastest spoken answers.
LIVE_EFFORT=low
# Lets Claude search the web for current facts. Anthropic bills each search.
ENABLE_WEB_SEARCH=false
# staff: only recognised staff get answers from the company knowledge base. everyone: no check.
KB_AUDIENCE=staff

# ---- Azure ------------------------------------------------------------------------------
# Storage: a connection string locally, or the account name in Azure (uses managed identity).
STORAGE_CONNECTION_STRING=
STORAGE_ACCOUNT_NAME=
# Azure Communication Services, used to join Teams meetings.
ACS_CONNECTION_STRING=
# Azure AI Speech, used for the voice.
SPEECH_KEY=
SPEECH_REGION=uksouth
# The newest, most natural British voices. en-GB-OllieMultilingualNeural is the male equivalent.
TTS_VOICE=en-GB-AdaMultilingualNeural

# ---- Control service and worker ------------------------------------------------------------
PORT=3978
# REQUIRED. A long random string shared by the control service and the worker.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SHARED_SECRET=
# local: start the worker as a child process. aca: start an Azure Container Apps job. none: do nothing.
DISPATCH_MODE=local
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
WORKER_JOB_NAME=
# Address the worker uses to reach the control service.
CONTROL_URL=http://127.0.0.1:3978

# ---- Limits and behaviour -------------------------------------------------------------------
# Pilot limits, kept low to control cost. They match the defaults in infra/apps.bicep.
MAX_MEETING_MINUTES=120
MAX_CONCURRENT_MEETINGS=2
# The assistant refuses new meetings once estimated spend passes this figure in a calendar month.
MONTHLY_BUDGET_USD=50
RETENTION_DAYS=90
# Seconds the assistant stays after everyone else has left.
ALONE_TIMEOUT_SECONDS=10
LOBBY_TIMEOUT_SECONDS=300
ANNOUNCE_ON_JOIN=true
POST_VOICE_ANSWERS_TO_CHAT=true
# General knowledge questions Claude may answer per meeting (outside the meeting and documents). 0 turns it off.
GENERAL_QUESTIONS_PER_MEETING=20
LOG_LEVEL=info

# ---- Worker only ----------------------------------------------------------------------------
# acs joins real Teams meetings. fake replays a script, for the demo and tests.
TRANSPORT=acs
# Path to Chrome for local runs. Leave empty in the container.
CHROME_PATH=
HEADLESS=true

# ---- Prices -----------------------------------------------------------------------------
# Optional JSON that overrides entries of the price table in src/core/pricing.ts, used for the
# spend estimate and the budget guard. Example, once you know Teams captions are not billed:
# PRICES_JSON={"captionsPerMinute":0}
PRICES_JSON=
